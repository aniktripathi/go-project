# Copy this file to ".env" and change the values. NEVER commit the real .env file.
APP_PORT=8080
GIN_MODE=debug

# PostgreSQL connection string. Replace YOUR_PASSWORD (and the database name if you like).
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/finance_tracker?sslmode=disable

# Secret used to sign login tokens. Must be at least 32 characters. Generate one in PowerShell with:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
JWT_SECRET=
JWT_EXPIRY_HOURS=24

# Comma separated list of frontend addresses allowed to call the API (CORS).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Maximum login/register requests per minute per IP address.
AUTH_RATE_LIMIT_PER_MIN=10

# Optional. Leave empty to disable expense prediction. Example: http://localhost:8001
ML_SERVICE_URL=
